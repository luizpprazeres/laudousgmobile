# =============================================================================
# LaudoUSG Mobile — env vars
# Copie para .env (raiz do monorepo) e preencha. NUNCA commitar .env real.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (PROJETO INTEIRO)
# -----------------------------------------------------------------------------
# URL pública do projeto (mesma usada pelo app e pelo backend)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/publishable key — usada pelo APP MOBILE (RLS protege)
SUPABASE_ANON_KEY=

# Service role key — APENAS BACKEND. NUNCA exposta no app.
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification (default audience é "authenticated")
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_ISS=

# Postgres connection string para Drizzle (usar pooler em produção)
# Padrão Supabase: postgres://postgres:[PASSWORD]@db.xxxx.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=

# -----------------------------------------------------------------------------
# OpenAI — APENAS BACKEND
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Modelos. Defaults seguem o LaudoUSG original (gpt-4.1-mini venceu A/B em
# 24 fixtures vs Llama 3.3 70B em 2026-04-25, +4.84pp similaridade média).
# A/B futuro: testar gpt-5-mini para custo/latência.
OPENAI_MODEL_STRUCTURER=gpt-4.1-mini
OPENAI_MODEL_WRITER=gpt-4.1-mini
WRITER_HARDENING=false
OPENAI_MODEL_SANITY=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Deepgram — APENAS BACKEND (proxy WS)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pt-BR

# -----------------------------------------------------------------------------
# App Mobile (Expo) — vars começando com EXPO_PUBLIC_ ficam embarcadas no bundle
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Pipeline / Observabilidade
# -----------------------------------------------------------------------------
# Versão do prompt global (incrementar a cada mudança em prompts/global.ts)
PROMPT_VERSION=v1.3
# Versão do schema StructuredFindings (incrementar a cada mudança)
FINDINGS_SCHEMA_VERSION=v1
# Versão dos contratos de categoria
CONTRACT_VERSION=v1

# Grava auditoria pesada da geração em public.generation_audit
GENERATION_AUDIT_ENABLED=false
