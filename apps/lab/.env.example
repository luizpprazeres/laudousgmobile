# --- Supabase (mesmas creds do monorepo .env) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend mobile (vivo em prod) ---
BACKEND_API_URL=https://laudousgmobile.vercel.app

# --- Admin do Lab (usado pelo proxy SSE do Testbench) ---
LAB_ADMIN_EMAIL=
LAB_ADMIN_PASSWORD=
ADMIN_EMAIL_WHITELIST=

# --- Basic auth do painel ---
# Quando setados, middleware exige Basic auth.
# Em dev local pode deixar vazio (passa direto).
LAB_BASIC_AUTH_USER=
LAB_BASIC_AUTH_PASS=
