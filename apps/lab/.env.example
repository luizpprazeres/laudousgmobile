# --- Supabase (mesmas creds do monorepo .env) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend mobile (vivo em prod) ---
BACKEND_API_URL=https://laudousgmobile.vercel.app

# --- Admin do Lab (usado pelo proxy SSE do Testbench) ---
LAB_ADMIN_EMAIL=
LAB_ADMIN_PASSWORD=
ADMIN_EMAIL_WHITELIST=

# --- Basic auth do painel ---
# Quando setados, middleware exige Basic auth.
# Em dev local pode deixar vazio (passa direto).
LAB_BASIC_AUTH_USER=
LAB_BASIC_AUTH_PASS=

# --- GitHub API (Editor Save em prod) ---
# Quando filesystem é read-only (Vercel prod), o PUT /api/blocks/file
# faz fallback pra commit no GitHub via Contents API. Branch direto no main.
# PAT requer scope `repo` (privado) ou `public_repo` (público).
# Gerar em: https://github.com/settings/tokens?type=beta (fine-grained recomendado)
GITHUB_TOKEN=
GITHUB_OWNER=luizpprazeres
GITHUB_REPO=laudousgmobile
GITHUB_BRANCH=main
