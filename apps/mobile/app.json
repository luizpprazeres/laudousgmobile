{
  "expo": {
    "name": "LaudoUSG",
    "slug": "laudousg-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/brand/expo/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "laudousg",
    "splash": {
      "image": "./assets/brand/logos/logo-laudousg-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laudousg.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O LaudoUSG precisa do microfone para ditar achados de exame."
      }
    },
    "android": {
      "package": "com.laudousg.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/expo/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/expo/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "O LaudoUSG precisa do microfone para ditar achados de exame."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
