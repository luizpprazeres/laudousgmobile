{
  "expo": {
    "name": "LaudoUSG",
    "slug": "laudousg-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/expo/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "laudousg",
    "splash": {
      "image": "./assets/brand/expo/logo-laudousg-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laudousg.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O LaudoUSG precisa do microfone para ditar achados de exame."
      }
    },
    "android": {
      "package": "com.laudousg.LaudoUSG",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/expo/adaptive-icon.png",
        "monochromeImage": "./assets/brand/expo/monochrome-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/expo/favicon.png"
    },
    "plugins": [
      "react-native-edge-to-edge",
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "O LaudoUSG precisa do microfone para ditar achados de exame."
        }
      ],
      "expo-font",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["image/*"],
          "androidMultiIntentFilters": ["image/*"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.fabric.** { *; }\n-keep class com.facebook.react.bridge.** { *; }\n-keep class com.facebook.react.uimanager.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.facebook.hermes.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8fc7cdda-5340-4c8b-b8eb-2319c71d1639"
      }
    },
    "owner": "luizprazeres"
  }
}
