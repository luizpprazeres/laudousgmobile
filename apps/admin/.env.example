# Painel /admin — variáveis SÓ do projeto admin (nunca no Git; na Vercel dependem do GO G8).
# Supabase (o service role fica só no servidor; nada aqui é NEXT_PUBLIC_).
SUPABASE_URL=https://yldtkqrsbgcnwlydrrot.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Allowlist: e-mails separados por vírgula. Vazia = ninguém entra.
ADMIN_EMAILS=
# Só "true" durante o primeiro cadastro do TOTP; depois volte para false.
ADMIN_ALLOW_MFA_ENROLL=false
# MFA obrigatório por padrão; "false" aceita só senha (allowlist e papel admin continuam valendo).
ADMIN_REQUIRE_MFA=true

# App Store Connect — chave App Manager (TestFlight). Use o conteúdo PEM em ASC_PRIVATE_KEY
# (com \n) OU, só no desenvolvimento local, o caminho do .p8 em ASC_PRIVATE_KEY_PATH.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=
ASC_PRIVATE_KEY_PATH=
ASC_APP_ID=6770609540
# Origem pública quando servido pelo rewrite da landing (https, sem caminho).
ADMIN_PUBLIC_ORIGIN=https://app.laudousg.com.br

# Relatórios de vendas/Analytics — dependem do GO G1 (chave "Sales and Reports" + vendor number).
ASC_REPORTS_KEY_ID=
ASC_REPORTS_PRIVATE_KEY=
ASC_REPORTS_PRIVATE_KEY_PATH=
ASC_VENDOR_NUMBER=

# E4: cron com Bearer obrigatório; pedido ONGOING já existente (nenhum POST na Apple).
# Instagram F3: o mesmo segredo protege /admin/api/cron/social (*/5) e /admin/api/cron/social-token (diário).
CRON_SECRET=
ASC_ANALYTICS_REQUEST_ID=4ab5fd58-848c-4d3b-aca7-954580b77c5b
# E5: deixe vazio enquanto o pt não tiver sido obtido no App Store Connect.
APPLE_CAMPAIGN_PT=

# Instagram F2 — "Instagram API com login do Instagram" (sem Página do Facebook).
# App da Meta: a URI de retorno cadastrada tem de ser exatamente
#   ${ADMIN_PUBLIC_ORIGIN}/admin/api/social/callback  (https://app.laudousg.com.br/admin/api/social/callback)
# Faltou qualquer uma das três (ou ADMIN_PUBLIC_ORIGIN) → "Conexão indisponível" e as rotas respondem 404.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Chave da cifra do token (AES-256-GCM) e da assinatura do state: 32 bytes aleatórios em base64,
# com ou sem o "=" final. Gere com: openssl rand -base64 32
# Trocar a chave invalida o token salvo (basta reconectar a conta).
SOCIAL_TOKEN_KEY=
