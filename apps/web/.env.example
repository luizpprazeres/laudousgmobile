# apps/web — variáveis de ambiente
# (No Vercel, configurar como Environment Variables do projeto da web.)

# Supabase (client-side precisa do prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (SÓ servidor — webhook atualiza profiles.plan bypassando RLS). NUNCA expor ao client.
SUPABASE_SERVICE_ROLE_KEY=

# Engine de geração (apps/api). Em prod aponta para a API pública.
NEXT_PUBLIC_API_URL=https://app.laudousg.com

# Exibe a revisão semântica do Companion somente nas categorias já liberadas
# também na API. Fail-closed: vazio por padrão.
NEXT_PUBLIC_COMPANION_FORM_PATCH_CATEGORIES=

# Avaliação multiparamétrica e elastografia hepática estruturadas.
# Ligar somente junto com HEPATIC_REPORTS_V1_ENABLED e as categorias ativas no banco.
NEXT_PUBLIC_HEPATIC_MODELS_V1=false

# AbacatePay (billing) — base: https://api.abacatepay.com/v2
# Chave de DEV agora; trocar pela de PRODUÇÃO no cutover (os product IDs mudam junto).
ABACATEPAY_API_KEY=
# Secret do webhook: vai na URL registrada no painel AbacatePay como
# ?webhookSecret=<este valor>. O endpoint /api/webhooks/abacate valida que bate.
ABACATEPAY_WEBHOOK_SECRET=
# IDs dos planos (modo DEV). Não são segredo. Recriar com a chave de prod no cutover.
ABACATEPAY_PRODUCT_ESSENCIAL=prod_LEWS1ptgTPRL3LSJqwzUWcT1
ABACATEPAY_PRODUCT_PROFISSIONAL=prod_S1M5s2XPr12WPWpUfCdHkdFM
