# apps/web — variáveis de ambiente
# (No Vercel, configurar como Environment Variables do projeto da web.)

# Supabase (client-side precisa do prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Engine de geração (apps/api). Em prod aponta para a API pública.
NEXT_PUBLIC_API_URL=https://app.laudousg.com

# AbacatePay (billing) — base: https://api.abacatepay.com/v2
# Chave de DEV agora; trocar pela de PRODUÇÃO no cutover (os product IDs mudam junto).
ABACATEPAY_API_KEY=
# Secret do webhook (definido ao registrar a URL do webhook no painel AbacatePay) — usado no S5.
ABACATEPAY_WEBHOOK_SECRET=
# IDs dos planos (modo DEV). Não são segredo. Recriar com a chave de prod no cutover.
ABACATEPAY_PRODUCT_ESSENCIAL=prod_LEWS1ptgTPRL3LSJqwzUWcT1
ABACATEPAY_PRODUCT_PROFISSIONAL=prod_S1M5s2XPr12WPWpUfCdHkdFM
