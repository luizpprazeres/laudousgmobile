{
  "name": "laudousg-mobile",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "description": "LaudoUSG Mobile — plataforma mobile-first para geração de laudos de ultrassonografia por IA",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @laudousg/db generate",
    "db:migrate": "pnpm --filter @laudousg/db migrate",
    "db:seed": "pnpm --filter @laudousg/db seed",
    "api:dev": "pnpm --filter @laudousg/api dev",
    "mobile:dev": "pnpm --filter @laudousg/mobile start",
    "validate:golden": "tsx scripts/golden-validation.ts",
    "validate:golden:objetivo": "tsx tests/golden-objetivo/runner.ts",
    "validate:golden:deterministico": "tsx tests/golden-deterministico/runner.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "next": "15.5.18",
    "openai": "^4.104.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
