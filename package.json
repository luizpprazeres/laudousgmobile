{
  "name": "laudousg-mobile",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "description": "LaudoUSG Mobile — plataforma mobile-first para geração de laudos de ultrassonografia por IA",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @laudousg/db generate",
    "db:migrate": "pnpm --filter @laudousg/db migrate",
    "db:seed": "pnpm --filter @laudousg/db seed",
    "api:dev": "pnpm --filter @laudousg/api dev",
    "mobile:dev": "pnpm --filter @laudousg/mobile start",
    "validate:golden": "tsx scripts/golden-validation.ts",
    "validate:golden:objetivo": "tsx tests/golden-objetivo/runner.ts",
    "validate:golden:deterministico": "tsx tests/golden-deterministico/runner.ts",
    "validate:fmf:trisomias": "tsx tests/fmf-trisomy/runner.ts && tsx apps/web/src/lib/calculators/trisomyFmf.test.mts",
    "validate:web:morfologico-1t": "tsx apps/web/src/lib/catalog/morfologicoPrimeiroTrimestre.test.mts",
    "validate:sprint6": "tsx tests/doppler-barcelona/runner.ts && tsx apps/api/src/server/renderer/__tests__/situacao-fetal-golden.manual.ts && tsx apps/api/src/server/renderer/__tests__/doppler-obstetrico-golden.manual.ts",
    "generate:fmf:trisomias": "node packages/fmf-trisomy/generate-params.mjs",
    "diff:bundle": "tsx scripts/diff-bundle-vs-original.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "next": "15.5.18",
    "openai": "^4.104.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
