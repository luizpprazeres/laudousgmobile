# Hoist global é REQUIRED pra Expo SDK 52 + Metro bundler em pnpm monorepo.
# Metro procura deps transitivas (expo-modules-core, @babel/runtime, react-native-web,
# react-refresh) em node_modules raiz, NÃO no nested .pnpm/ structure.
# Sem essa flag, EAS Build falha com "Unable to resolve module expo-modules-core".
node-linker=hoisted
auto-install-peers=true
strict-peer-dependencies=false
legacy-peer-deps=true
